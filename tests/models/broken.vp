//
// PUBKEY takes one argument. Used to pin that a model error becomes a
// diagnostic on the line that caused it.

attacker[active]

principal Alice[
	knows public c0
	generates a
	ga = PUBKEY(a, c0)
]

queries[
	confidentiality? a
]
